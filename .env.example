# Nova fleet tracking — example environment variables.
# Copy this file to .env and adjust the values for your environment.
# Environment variables override the corresponding values in config.yaml.

# Path to the YAML configuration file (default: config.yaml)
NOVA_CONFIG=config.yaml

# Kafka bootstrap servers (overrides kafka.bootstrap_servers)
NOVA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka consumer group id (overrides kafka.group_id)
NOVA_KAFKA_GROUP_ID=nova-processor

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
NOVA_LOG_LEVEL=INFO

# --- Optional SASL security placeholders ---
# Leave these unset for plaintext local development. When a username and
# password are supplied, the processor enables SASL authentication.
NOVA_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
NOVA_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
NOVA_KAFKA_SASL_USERNAME=
NOVA_KAFKA_SASL_PASSWORD=
